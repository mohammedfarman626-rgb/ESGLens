# Copy this file to .streamlit/secrets.toml (same folder) and paste your
# own key in. secrets.toml is gitignored — it will never be committed or
# pushed to GitHub. Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY = "your-gemini-api-key-here"

# --- Optional: multiple keys ------------------------------------------------
# Gemini's free tier currently allows only ~20 requests/day, PER GOOGLE
# CLOUD PROJECT (not per key) — and a fresh Google account normally gets
# its own project. So if you have several of your own Google accounts, one
# free-tier key from each gives ESGLens that many independent daily
# budgets: it automatically rotates to the next key if one hits its cap.
#
# To use this, comment out GEMINI_API_KEY above and use a list instead:
#
# GEMINI_API_KEYS = [
#     "key-from-account-1",
#     "key-from-account-2",
#     "key-from-account-3",
# ]
